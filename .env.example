# Deployment config: the single source of truth for one deployment.
# Copy to .env and fill in. docker compose reads it natively; Django settings.py
# and the frontend build read the names below.
# Deploy: bash deploy.sh    Down: docker compose down

# -- Site --------------------------------------------------------------------
# local (auto-login dev mode) or deployment.
APP_ENV=deployment
# Public address of the site; emailed links point here.
SITE_URL=https://brainrot.jacob-waters.com
# console writes emails to the backend log; resend sends them through Resend.
EMAIL_DELIVERY=console

# -- Secrets (generate with: openssl rand -hex 32) ----------------------------
# Django signing key for sessions and CSRF tokens.
DJANGO_SECRET_KEY=
# Password for the Postgres database user.
POSTGRES_PASSWORD=

# -- Services (each may be empty; the matching feature is then off) ----------
# Google Sign-In OAuth web client id; empty hides the Google button.
GOOGLE_CLIENT_ID=
# Stripe test-mode secret key (backend).
STRIPE_TEST_SECRET_KEY=
# Stripe test-mode publishable key (built into the frontend).
STRIPE_TEST_PUBLISHABLE_KEY=
# Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=
# Resend API key, used when EMAIL_DELIVERY=resend.
RESEND_API_KEY=
# OpenRouter API key for LLM classification.
OPENROUTER_API_KEY=
# Cloudflare Tunnel token, for when the public domain is ready (see DEPLOY.md).
CLOUDFLARE_TUNNEL_TOKEN=

# -- Classification inference -----------------------------------------------
# openrouter or local: where the worker sends classification prompts.
INFERENCE_SOURCE=openrouter
# OpenRouter model id, used when INFERENCE_SOURCE=openrouter.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# OpenAI-compatible base URL (ending in /v1) and model, used when INFERENCE_SOURCE=local.
LOCAL_INFERENCE_BASE_URL=
LOCAL_INFERENCE_MODEL=
