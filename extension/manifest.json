{
  "manifest_version": 3,
  "name": "BrainRot Index",
  "short_name": "BrainRot",
  "version": "0.0.1",
  "description": "BrainRot Index - The algorithm that works for you",
  "homepage_url": "https://brainrotindex.com",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": [
    "https://brainrot.jacob-waters.com/*",
    "https://brainrotindex.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.reddit.com/*"],
      "js": ["extension-api.js", "content/post-decoration.js", "sites/reddit.js", "content/feed-watcher.js"],
      "css": ["content/post-decoration.css", "sites/reddit.css"]
    },
    {
      "matches": ["https://x.com/*"],
      "js": ["extension-api.js", "content/post-decoration.js", "sites/x.js", "content/feed-watcher.js"],
      "css": ["content/post-decoration.css", "sites/x.css"]
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["extension-api.js", "content/post-decoration.js", "sites/youtube.js", "content/feed-watcher.js"],
      "css": ["content/post-decoration.css", "sites/youtube.css"]
    },
    {
      "matches": ["https://brainrot.jacob-waters.com/*", "https://brainrotindex.com/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["extension-api.js", "content/connect-listener.js"]
    }
  ]
}
